# ─── Alpaca Paper Trading Keys ───────────────────────────────────────────────
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Featherless AI (from hackathon credits) ──────────────────────────────────
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ─── Oracle Settings ─────────────────────────────────────────────────────────
ORACLE_SCAN_INTERVAL_MINUTES=15
ORACLE_MAX_POSITIONS=6
ORACLE_MAX_RISK_PER_TRADE_PCT=2.0
ORACLE_DAILY_LOSS_LIMIT_PCT=5.0
ORACLE_COUNCIL_APPROVAL_THRESHOLD=70
ORACLE_PROFIT_TAKE_PCT=50
ORACLE_STOP_LOSS_PCT=200

# ─── Strategy Settings ────────────────────────────────────────────────────────
MOMENTUM_FADE_MIN_MOVE_PCT=5.0
IV_CRUSH_MIN_IV_RANK=40
SENTIMENT_EXTREME_THRESHOLD=80
VIX_CALM_THRESHOLD=15
VIX_FEAR_THRESHOLD=25

# ─── Social / Narrator ───────────────────────────────────────────────────────
NARRATOR_ENABLED=true
NARRATOR_OUTPUT_FILE=narrator_posts.txt
